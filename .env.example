# ---------------------------------------------------------------------------
# ZyPanel configuration
# Copy to .env and adjust. Never commit the real .env.
# ---------------------------------------------------------------------------

# Listen address inside the container.
ZYPANEL_ADDR=:8090

# REQUIRED: random string used to sign session cookies.
# Generate with: openssl rand -hex 32
ZYPANEL_SECRET_KEY=change-me-please-use-a-random-64-char-string

# REQUIRED: admin credentials.
# Either set a plain password (hashed in memory at boot) ...
ZYPANEL_ADMIN_USER=admin
ZYPANEL_ADMIN_PASSWORD=change-me-now
# ... or provide a bcrypt hash directly (takes precedence):
# ZYPANEL_ADMIN_PASSWORD_HASH=$2a$12$...

# Set to 1 when served over HTTPS (recommended behind a tunnel / reverse proxy).
ZYPANEL_COOKIE_SECURE=1

# Where runtime data (audit log, favorites) is stored.
ZYPANEL_DATA_DIR=/data

# Feature toggles. Disable what you do not mount.
ZYPANEL_DOCKER=1
# Requires pid: host, privileged: true and /run mounted. Uses the bundled
# systemctl-host wrapper to reach the host's systemd.
ZYPANEL_SYSTEMD=0
# Requires /etc/cloudflared mounted read-write and the cloudflared binary
# (bundled in the image).
ZYPANEL_CLOUDFLARED=0
ZYPANEL_OPENCLAW=0

# Read-only mode: hides every mutating action.
ZYPANEL_READ_ONLY=0

# Binary paths (inside the container).
ZYPANEL_DOCKER_BIN=docker
ZYPANEL_SYSTEMCTL_BIN=systemctl-host
ZYPANEL_CLOUDFLARED_BIN=cloudflared
ZYPANEL_CLOUDFLARED_CONFIG=/etc/cloudflared/config.yml
ZYPANEL_OPENCLAW_BIN=openclaw

# Optional: restrict cloudflared hostname editing to a DNS suffix.
# ZYPANEL_CLOUDFLARED_SUFFIX_ALLOWLIST=.example.com
